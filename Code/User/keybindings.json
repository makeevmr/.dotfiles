[
    {
        "key": "alt+k",
        "command": "-claude-vscode.insertAtMention"
    },
    {
        "key": "alt+k",
        "command": "extension.vim_escape",
        "when": "editorTextFocus && vim.active"
    },
    {
        "key": "ctrl+j",
        "command": "selectNextSuggestion",
        "when": "suggestWidgetVisible && textInputFocus"
    },
    {
        "key": "ctrl+k",
        "command": "selectPrevSuggestion",
        "when": "suggestWidgetVisible && textInputFocus"
    },

    // Telescope
    {
        "key": "alt+m f",
        "command": "-code-telescope.fuzzy.file"
    },
    {
        "key": "alt+m r",
        "command": "-code-telescope.fuzzy.recentFiles"
    },
    {
        "key": "alt+m g",
        "command": "-code-telescope.fuzzy.wsText"
    },

    // Harpoon
    {
        "key": "alt+m m",
        "command": "-code-telescope.fuzzy.harpoon"
    },
    {
        "key": "alt+h",
        "command": "code-telescope.fuzzy.harpoon",
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },
    {
        "key": "ctrl+alt+m",
        "command": "-code-telescope.harpoon.addFile"
    },
    {
        "key": "alt+a",
        "command": "code-telescope.harpoon.addFile",
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },
    {
        "key": "ctrl+1",
        "command": "-code-telescope.harpoon.gotoFile1"
    },
    {
        "key": "ctrl+2",
        "command": "-code-telescope.harpoon.gotoFile2"
    },
    {
        "key": "ctrl+3",
        "command": "-code-telescope.harpoon.gotoFile3"
    },
    {
        "key": "ctrl+4",
        "command": "-code-telescope.harpoon.gotoFile4"
    },
    {
        "key": "ctrl+5",
        "command": "-code-telescope.harpoon.gotoFile5"
    },
    {
        "key": "ctrl+6",
        "command": "-code-telescope.harpoon.gotoFile6"
    },
    {
        "key": "ctrl+7",
        "command": "-code-telescope.harpoon.gotoFile7"
    },
    {
        "key": "ctrl+8",
        "command": "-code-telescope.harpoon.gotoFile8"
    },
    {
        "key": "ctrl+9",
        "command": "-code-telescope.harpoon.gotoFile9"
    },
    {
        "key": "alt+1",
        "command": "runCommands",
        "args": {
            "commands": ["code-telescope.harpoon.gotoFile1", "cursorUndo"]
        },
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },
    {
        "key": "alt+2",
        "command": "runCommands",
        "args": {
            "commands": ["code-telescope.harpoon.gotoFile2", "cursorUndo"]
        },
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },
    {
        "key": "alt+3",
        "command": "runCommands",
        "args": {
            "commands": ["code-telescope.harpoon.gotoFile3", "cursorUndo"]
        },
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },
    {
        "key": "alt+4",
        "command": "runCommands",
        "args": {
            "commands": ["code-telescope.harpoon.gotoFile4", "cursorUndo"]
        },
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },
    {
        "key": "alt+5",
        "command": "runCommands",
        "args": {
            "commands": ["code-telescope.harpoon.gotoFile5", "cursorUndo"]
        },
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },
    {
        "key": "alt+6",
        "command": "runCommands",
        "args": {
            "commands": ["code-telescope.harpoon.gotoFile6", "cursorUndo"]
        },
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },
    {
        "key": "alt+7",
        "command": "runCommands",
        "args": {
            "commands": ["code-telescope.harpoon.gotoFile7", "cursorUndo"]
        },
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },
    {
        "key": "alt+8",
        "command": "runCommands",
        "args": {
            "commands": ["code-telescope.harpoon.gotoFile8", "cursorUndo"]
        },
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },
    {
        "key": "alt+9",
        "command": "runCommands",
        "args": {
            "commands": ["code-telescope.harpoon.gotoFile9", "cursorUndo"]
        },
        "when": "editorTextFocus && vim.mode == 'Normal'"
    }
]
