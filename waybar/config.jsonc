{
    "layer": "top",
    "position": "top",
    "modules-left": ["sway/workspaces", "sway/language", "wireplumber", "backlight", "custom/power-profile", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "custom/temperature", "memory", "disk", "battery", "tray"],
    "sway/workspaces": {
        "on-click": "activate"
    },
    "sway/language": {
        "format": "LANG: {shortDescription}",
        "tooltip-format": "{long}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },
    "wireplumber": {
        "format": "VOL: {volume}%",
        "format-muted": "VOL: MUTED",
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "BRIGHT: {percent}%",
        "scroll-step": 5,
        "tooltip": false
    },
    "custom/power-profile": {
        "exec": "powerprofilesctl get",
        "interval": 5,
        "format": "MODE: {}",
        "tooltip": false
    },
    "clock": {
        "format": "{:%H:%M %d %b %a}",
        "locale": "en_GB.UTF-8",
        "tooltip-format": "{calendar}"
    },
    "cpu": {
        "interval": 10,
        "format": "CPU: {usage}%",
        "states": {
            "warning": 75,
            "critical": 90
        },
    },
    // Native temperature warning-threshold requires Waybar >= 0.12.
    "custom/temperature": {
        "exec": "awk -v warning=75 -v critical=90 '{t = int(($1 + 500) / 1000); printf \"%d\\n%d°C\\n%s\\n\", t, t, (t >= critical ? \"critical\" : t >= warning ? \"warning\" : \"normal\")}' /sys/class/thermal/thermal_zone0/temp",
        "interval": 10,
        "format": "TEMP: {}°C"
    },
    "memory": {
        "interval": 30,
        "format": "RAM: {avail:0.1f}GiB",
        "states": {
            "warning": 75,
            "critical": 90
        },
    },
    "disk": {
        "interval": 30,
        "format": "DISK: {free}",
        "states": {
            "warning": 75,
            "critical": 90
        }
    },
    "battery": {
        "interval": 60,
        "format": "BAT: {capacity}%",
        "states": {
            "warning": 25,
            "critical": 10
        },
    },
    "tray": {
        "spacing": 8
    }
}
